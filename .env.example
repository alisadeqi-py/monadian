# Copy this file to .env and fill in real values before running
# docker-compose.prod.yml. See DEPLOYMENT.md for the full walkthrough.

# ---- Domain -----------------------------------------------------------
# Replace with your real domain everywhere it appears (this file, nginx
# config, deploy/init-letsencrypt.sh).
DOMAIN=yourdomain.example

# ---- Django -------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.example
CORS_ALLOWED_ORIGINS=https://yourdomain.example
CSRF_TRUSTED_ORIGINS=https://yourdomain.example

# ---- Postgres -----------------------------------------------------------
POSTGRES_DB=monadian
POSTGRES_USER=monadian
POSTGRES_PASSWORD=change-me-to-a-strong-password
# Must match the POSTGRES_* values above (hostname "db" is the compose service name).
DATABASE_URL=postgres://monadian:change-me-to-a-strong-password@db:5432/monadian

# ---- Next.js --------------------------------------------------------------
# Public/browser-facing API + site URL — baked into the client bundle at
# build time, so docker-compose.prod.yml passes NEXT_PUBLIC_API_URL as a
# build arg too.
NEXT_PUBLIC_API_URL=https://yourdomain.example
NEXT_PUBLIC_SITE_URL=https://yourdomain.example
# Server-facing (Next.js server components) — internal Docker network hostname.
API_INTERNAL_URL=http://backend:8000
