# Read automatically by `next build` / `next start` (Next.js built-in
# convention — no extra wiring needed). NEXT_PUBLIC_* values are inlined
# into the client bundle at build time, so this file must exist BEFORE the
# Docker image is built (i.e. before you drag-and-drop / upload this
# folder to Runflare).
NEXT_PUBLIC_API_URL=http://backend.monadianfath.com
NEXT_PUBLIC_SITE_URL=https://monadianfath.com
